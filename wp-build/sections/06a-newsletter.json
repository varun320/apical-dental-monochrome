      "elements": [
        { "id": "w06n01", "elType": "widget", "widgetType": "heading", "settings": { "title": "STAY CLOSE", "header_size": "h6", "typography_typography": "custom", "typography_font_family": "Inter", "typography_font_size": { "unit": "px", "size": 12 }, "typography_font_weight": "500", "typography_letter_spacing": { "unit": "px", "size": 2 }, "typography_text_transform": "uppercase", "title_color": "#1A1A1C", "_animation": "fadeInUp" } },
        { "id": "w06n02", "elType": "widget", "widgetType": "heading", "settings": { "title": "A weekly dispatch from the lab.", "header_size": "h2", "typography_typography": "custom", "typography_font_family": "Fraunces", "typography_font_size": { "unit": "rem", "size": 3.5 }, "typography_font_size_tablet": { "unit": "rem", "size": 2.5 }, "typography_font_size_mobile": { "unit": "rem", "size": 2 }, "typography_font_weight": "300", "typography_font_style": "italic", "typography_line_height": { "unit": "em", "size": 1.05 }, "typography_letter_spacing": { "unit": "px", "size": -1.5 }, "title_color": "#1A1A1C", "_animation": "fadeInUp", "_animation_delay": 120 } },
        { "id": "w06n03", "elType": "widget", "widgetType": "text-editor", "settings": { "editor": "<p>Short clips from the bench &mdash; a humanoid adjusting a denture at a kitchen table, a robot tuning a garden bed, the next evolution of care in 90 seconds. No selling. No noise. Unsubscribe in one click.</p>", "typography_typography": "custom", "typography_font_family": "Inter", "typography_font_size": { "unit": "rem", "size": 1.125 }, "typography_line_height": { "unit": "em", "size": 1.65 }, "text_color": "rgba(26,26,28,0.78)", "_animation": "fadeInUp", "_animation_delay": 240 } }
      ]
    },
    {
      "id": "col06nb",
      "elType": "column",
      "settings": { "_column_size": 50, "_inline_size_tablet": 100, "margin_tablet": { "unit": "px", "top": "40", "right": "0", "bottom": "0", "left": "0", "isLinked": false }, "content_position": "center" },
      "elements": [
        { "id": "w06n04", "elType": "widget", "widgetType": "html", "settings": { "html": "<form action=\"#\" method=\"post\" data-ap-newsletter=\"pending-webhook\" class=\"ap-news-form\" style=\"background:#FFFFFF;padding:40px;border:1px solid rgba(26,26,28,0.12)\" onsubmit=\"event.preventDefault();this.querySelector('[data-ok]').style.display='block';this.querySelector('button').textContent='Saved \\u2713';this.querySelector('button').disabled=true\"><div style=\"font-family:Inter;font-size:11px;font-weight:500;letter-spacing:2px;text-transform:uppercase;color:#B85C3C;margin-bottom:14px\">Free · Weekly</div><label for=\"ap-news-email\" style=\"display:block;font-family:Inter;font-size:14px;font-weight:500;color:#1A1A1C;margin-bottom:10px\">Email</label><input id=\"ap-news-email\" name=\"email\" type=\"email\" required placeholder=\"you@practice.com\" style=\"width:100%;padding:16px 18px;font-family:Inter;font-size:15px;border:1px solid rgba(26,26,28,0.25);background:#F3EEE5;color:#1A1A1C;outline:none;margin-bottom:20px;border-radius:0\" /><button type=\"submit\" style=\"width:100%;padding:18px 28px;background:#B85C3C;color:#F3EEE5;font-family:Inter;font-size:15px;font-weight:500;letter-spacing:0.5px;border:none;cursor:pointer;border-radius:0\">Subscribe</button><div data-ok style=\"display:none;margin-top:18px;font-family:Inter;font-size:13px;color:rgba(26,26,28,0.65);line-height:1.55\">We&rsquo;ll send the first dispatch within seven days.</div><div style=\"margin-top:18px;font-family:Inter;font-size:12px;color:rgba(26,26,28,0.55);line-height:1.55\">One email a week. No partner spam. Your address is used only to send the dispatch.</div></form><style>@media (max-width:560px){.ap-news-form{padding:28px 22px !important}.ap-news-form input,.ap-news-form button{padding:14px 16px !important;font-size:14px !important}}</style>", "_animation": "fadeInUp", "_animation_delay": 300 } }
      ]
