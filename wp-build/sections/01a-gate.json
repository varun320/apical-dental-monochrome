      "elements": [
        { "id": "w01g01", "elType": "widget", "widgetType": "heading", "settings": { "title": "WHO IS THIS FOR", "header_size": "h6", "typography_typography": "custom", "typography_font_family": "Inter", "typography_font_size": { "unit": "px", "size": 12 }, "typography_font_weight": "500", "typography_letter_spacing": { "unit": "px", "size": 2 }, "typography_text_transform": "uppercase", "title_color": "#1A1A1C", "_animation": "fadeInUp" } },
        { "id": "w01g02", "elType": "widget", "widgetType": "heading", "settings": { "title": "Pick your path.", "header_size": "h2", "typography_typography": "custom", "typography_font_family": "Fraunces", "typography_font_size": { "unit": "rem", "size": 3.25 }, "typography_font_size_tablet": { "unit": "rem", "size": 2.5 }, "typography_font_size_mobile": { "unit": "rem", "size": 1.875 }, "typography_font_weight": "300", "typography_font_style": "italic", "typography_line_height": { "unit": "em", "size": 1.05 }, "typography_letter_spacing": { "unit": "px", "size": -1.5 }, "title_color": "#1A1A1C", "_animation": "fadeInUp", "_animation_delay": 120, "_margin": { "unit": "px", "top": "0", "right": "0", "bottom": "32", "left": "0", "isLinked": false } } },
        { "id": "w01g03", "elType": "widget", "widgetType": "html", "settings": { "html": "<div style=\"display:grid;grid-template-columns:repeat(2,1fr);gap:24px\" class=\"ap-gate-grid\"><a href=\"/apicaldental/for-dsos\" style=\"display:block;padding:48px 40px;background:#FFFFFF;border:1px solid rgba(26,26,28,0.12);text-decoration:none;color:#1A1A1C;transition:transform .25s ease,border-color .25s ease\"><div style=\"font-family:Inter;font-size:11px;font-weight:500;letter-spacing:2px;text-transform:uppercase;color:#B85C3C;margin-bottom:18px\">For dental professionals</div><div style=\"font-family:Fraunces;font-size:2.25rem;font-weight:300;line-height:1.08;letter-spacing:-1px;margin-bottom:18px\">Put a robot in every chair.</div><div style=\"font-family:Inter;font-size:15px;line-height:1.6;color:rgba(26,26,28,0.7);margin-bottom:28px\">Surgical-grade on-site lab, leased per chair. Built for DSO networks, independent practices, and robotic manufacturers piloting in clinic.</div><span style=\"font-family:Inter;font-size:14px;font-weight:500;letter-spacing:0.5px;border-bottom:1px solid #1A1A1C;padding-bottom:2px\">See the case &rarr;</span></a><a href=\"/apicaldental/contact\" style=\"display:block;padding:48px 40px;background:#FFFFFF;border:1px solid rgba(26,26,28,0.12);text-decoration:none;color:#1A1A1C;transition:transform .25s ease,border-color .25s ease\"><div style=\"font-family:Inter;font-size:11px;font-weight:500;letter-spacing:2px;text-transform:uppercase;color:#B85C3C;margin-bottom:18px\">For families &amp; home care</div><div style=\"font-family:Fraunces;font-size:2.25rem;font-weight:300;line-height:1.08;letter-spacing:-1px;margin-bottom:18px\">A trained robot at home.</div><div style=\"font-family:Inter;font-size:15px;line-height:1.6;color:rgba(26,26,28,0.7);margin-bottom:28px\">Elder-care support, garden-to-table prep, denture adjustments at the kitchen table. Training transfers to every robot in the network.</div><span style=\"font-family:Inter;font-size:14px;font-weight:500;letter-spacing:0.5px;border-bottom:1px solid #1A1A1C;padding-bottom:2px\">Talk to us &rarr;</span></a></div><style>.ap-gate-grid > a > div:nth-of-type(2){font-size:clamp(1.625rem,4vw + 0.5rem,2.25rem) !important}@media (max-width:900px){.ap-gate-grid{grid-template-columns:1fr !important;gap:18px !important}}@media (max-width:560px){.ap-gate-grid > a{padding:36px 26px !important}}.ap-gate-grid > a:hover{border-color:#B85C3C !important;transform:translateY(-4px)}</style>", "_animation": "fadeInUp", "_animation_delay": 240 } }
      ]
